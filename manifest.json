{
  "manifest_version": 3,
  "name": "Hianime Live Japanese Subtitles",
  "description": "Live Japanese subtitles using local Moonshine AI (WebGPU) with Groq Whisper fallback and Silero VAD.",
  "version": "0.3.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Live subtitles",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src https://api.groq.com;"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "models/*",
        "models/onnx/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

